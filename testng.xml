<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="UNCS Suite">

    <test name="Authentication">
        <classes>
            <class name="com.uncs.testcases.LoginTest"/>
        </classes>
    </test>

    <!--
      The Cucumber runner. It picks up every feature under src/test/resources and, by the
      tag filter in TestRunner, leaves the @e2e journey out of a plain run. Launch that one
      on its own with:  mvn test -Dcucumber.filter.tags="@e2e"
    -->
    <test name="Cucumber">
        <classes>
            <class name="com.uncs.runner.TestRunner"/>
        </classes>
    </test>

</suite>
